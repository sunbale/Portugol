programa
{
	
	funcao inicio()
	{
		inteiro numero

		escreva ("digite um número inteiro: ")
		leia (numero)
		se (numero > 0)
		{
			escreva ("O número é positivo")
		}
		senao se (numero < 0)
		{
			escreva ("o numero é negativo")
		}
		senao
		{
		escreva ("o numero é igual a zero")
		}
		
		}
	}

