programa
{
inclua biblioteca Matematica --> mat
	
	funcao inicio()
	{
		real m1, m2
escreva ("informe o primeiro numero")
leia (m1)
escreva ("informe o segundo número")
leia (m2)

se (m1 < m2)
{
	escreva (m1 + " é menor que " + m2)
}
se (m1 > m2)
{
	escreva (m1 + " é maior que " + m2)
}
	}
}
