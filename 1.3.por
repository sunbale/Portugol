programa
{

	
//1.2 Peça ao usuario que informe o nome e exiba a mensagem: Olá [nomedousuario].
	
	funcao inicio()
	{
		cadeia nome_usuario
		cadeia idade
		escreva("informe o seu nome: ")
		leia(nome_usuario)
		
		escreva("informe a sua idade: ")
		leia(idade)
		escreva("olá, " ,nome_usuario, "\n", "sua idade é ",idade)
		
	}
}
