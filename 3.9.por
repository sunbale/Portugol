programa
{
	funcao inicio()
	{
		inteiro n1, n2, n3, n4, n5, n6, n7, n8, n9, n10
		inteiro dentro = 0
		inteiro fora = 0

		escreva("Informe o primeiro número: ")
		leia(n1)

		escreva("Informe o segundo número: ")
		leia(n2)

		escreva("Informe o terceiro número: ")
		leia(n3)

		escreva("Informe o quarto número: ")
		leia(n4)

		escreva("Informe o quinto número: ")
		leia(n5)

		escreva("Informe o sexto número: ")
		leia(n6)

		escreva("Informe o sétimo número: ")
		leia(n7)

		escreva("Informe o oitavo número: ")
		leia(n8)

		escreva("Informe o nono número: ")
		leia(n9)

		escreva("Informe o décimo número: ")
		leia(n10)

		se (n1 >= 24 e n1 <= 42)
		{
			dentro++
			escreva("\n", n1, " está dentro do intervalo.")
		}
		senao
		{
			fora++
			escreva("\n", n1, " está fora do intervalo.")
		}

		se (n2 >= 24 e n2 <= 42)
		{
			dentro++
			escreva("\n", n2, " está dentro do intervalo.")
		}
		senao
		{
			fora++
			escreva("\n", n2, " está fora do intervalo.")
		}

		se (n3 >= 24 e n3 <= 42)
		{
			dentro++
			escreva("\n", n3, " está dentro do intervalo.")
		}
		senao
		{
			fora++
			escreva("\n", n3, " está fora do intervalo.")
		}

		se (n4 >= 24 e n4 <= 42)
		{
			dentro++
			escreva("\n", n4, " está dentro do intervalo.")
		}
		senao
		{
			fora++
			escreva("\n", n4, " está fora do intervalo.")
		}

		se (n5 >= 24 e n5 <= 42)
		{
			dentro++
			escreva("\n", n5, " está dentro do intervalo.")
		}
		senao
		{
			fora++
			escreva("\n", n5, " está fora do intervalo.")
		}

		se (n6 >= 24 e n6 <= 42)
		{
			dentro++
			escreva("\n", n6, " está dentro do intervalo.")
		}
		senao
		{
			fora++
			escreva("\n", n6, " está fora do intervalo.")
		}

		se (n7 >= 24 e n7 <= 42)
		{
			dentro++
			escreva("\n", n7, " está dentro do intervalo.")
		}
		senao
		{
			fora++
			escreva("\n", n7, " está fora do intervalo.")
		}

		se (n8 >= 24 e n8 <= 42)
		{
			dentro++
			escreva("\n", n8, " está dentro do intervalo.")
		}
		senao
		{
			fora++
			escreva("\n", n8, " está fora do intervalo.")
		}

		se (n9 >= 24 e n9 <= 42)
		{
			dentro++
			escreva("\n", n9, " está dentro do intervalo.")
		}
		senao
		{
			fora++
			escreva("\n", n9, " está fora do intervalo.")
		}

		se (n10 >= 24 e n10 <= 42)
		{
			dentro++
			escreva("\n", n10, " está dentro do intervalo.")
		}
		senao
		{
			fora++
			escreva("\n", n10, " está fora do intervalo.")
		}

		escreva("\n\nQuantidade dentro do intervalo: ", dentro)
		escreva("\nQuantidade fora do intervalo: ", fora)
	}
}
