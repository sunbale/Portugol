programa
{
inclua biblioteca Matematica --> mat
	
	funcao inicio()
	{
		real m1, m2, m3, m4, m5, m6, media

		escreva ("informe a média 1: ")
		leia (m1)
		escreva ("informe a média 2: ")
		leia (m2)
		escreva ("informe a média 3: ")
		leia (m3)
		escreva ("informe a média 4: ")
		leia (m4)
		escreva ("informe a média 5: ")
		leia (m5)
		escreva ("informe a média 6: ")
		leia (m6)

		media = (m1 + m2 + m3+ m4 + m5 + m6) / 3
		limpa ()
		escreva ("sua média final é: ", mat.arredondar (media,2))
		
	}
}
