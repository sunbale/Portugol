programa
{
inclua biblioteca Matematica --> mat
	
	funcao inicio()
	{
		real m1, m2, m3, m4, m5, m6, soma
		soma = 0

		escreva ("informe o primeiro número ")
		leia (m1)
		escreva ("informe o segundo número ")
		leia (m2)
		escreva ("informe o terceiro número ")
		leia (m3)
		escreva ("informe o quarto número ")
		leia (m4)
		escreva ("informe o quinto número ")
		leia (m5)
		escreva ("informe o sexto número ")
		leia (m6)

		se (m1 < 72)
		{
			soma = soma + m1
		}

		se (m2 < 72)
		{
			soma = soma + m2
		}

		se (m3 < 72)
		{
			soma = soma + m3
		}

		se (m4 < 72)
		{
			soma = soma + m4
		}

		se (m5 < 72)
		{
			soma = soma + m5
		}

		se (m6 < 72)
		{
			soma = soma + m6
		}

		escreva("O resultado é: ", soma)
		escreva ("\nforam somados apenas os números menores que 72")
	}
	
}
